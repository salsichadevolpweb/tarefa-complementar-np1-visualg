algoritmo "Exercicio7"

var
   base, resultado: real
   expoente, contador: inteiro

inicio
   escreva("Digite a base: ")
   leia(base)

   escreva("Digite o expoente: ")
   leia(expoente)

   resultado <- 1

   para contador de 1 ate expoente faca
      resultado <- resultado * base
   fimpara

   escreva("O resultado da potência é: ", resultado)

fimalgoritmo