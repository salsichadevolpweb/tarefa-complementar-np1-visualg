algoritmo "Exercicio6"

var
   opcao, numero, contador: inteiro

inicio
   escreva("Deseja visualizar as tabuadas de 1 a 10? ")
   escreva("(1 = Sim / 2 = Não): ")
   leia(opcao)

   se opcao = 1 entao

      para numero de 1 ate 10 faca

         escreval()
         escreval("Tabuada do ", numero)

         para contador de 1 ate 10 faca
            escreval(numero, " x ", contador, " = ", numero * contador)
         fimpara

      fimpara

   senao
      escreva("Programa encerrado")
   fimse

fimalgoritmo